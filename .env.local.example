# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.
# On Vercel, set the same variables under Settings → Environment Variables.
# NOTE: Vercel env vars only apply to deployments created AFTER they're added —
# adding one does not affect the currently-running deployment. Redeploy to apply.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Public site reads (landing / browse / detail). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# Service-role key — SERVER ONLY, bypasses RLS. Powers the review API, the
# ingest script and the expiry cron. Never expose to the browser and never
# prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin review queue (required for /admin/review) ─────────────────────────
# Shared secret for /admin/review and its API routes, validated server-side on
# every request. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_REVIEW_SECRET=

# ── Daily auto-expiry cron (required) ──────────────────────────────────────
# Authorises GET /api/cron/expire, which flips ended listings to
# status=expired so they drop off the site. Vercel Cron (see vercel.json) sends
# this automatically as a Bearer token. Without it the cron 401s silently and
# ended events keep showing as current.
CRON_SECRET=

# ── Resend (optional) ───────────────────────────────────────────────────────
# Powers the "Send to me" email option (app/api/share).
# 1. Create a key at https://resend.com/api-keys
# 2. Verify the sending domain (e.g. jungle.baby) at https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# From address — MUST be on a domain you've verified in Resend.
SHARE_FROM_EMAIL="Jungle Summer <summer@jungle.baby>"
